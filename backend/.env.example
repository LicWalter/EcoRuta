# Configuración del servidor
PORT=3000

# Conexión a PostgreSQL (Neon o local)
DATABASE_URL=postgresql://usuario:contrasena@localhost:5432/ecoruta

# JSON Web Token (JWT) - RNF-02
JWT_SECRET=clave-secreta-para-firmar-jwt-cambiar-en-produccion
JWT_EXPIRES_IN=8h

# CORS - Origen permitido para el Frontend
# URL del frontend permitida por CORS. En producción, la de Netlify (puede ir más de una, separadas por comas).
# En desarrollo también se acepta cualquier http://localhost.
FRONTEND_URL=http://localhost:5173
# development en tu computador, production en Render
NODE_ENV=development

# Credenciales para el script crear-admin (RF-05)
ADMIN_NOMBRE=Administrador EcoRuta
ADMIN_EMAIL=admin@ecoruta.co
ADMIN_PASSWORD=Admin123456*
